  {
    "title": "ディアマンクッキー2種（チョコチップ＆紅茶）",
    "servings": "",
    "ingredients": [
      {
        "name": "無塩バター",
        "amount": "100g"
      },
      {
        "name": "粉糖",
        "amount": "60g"
      },
      {
        "name": "卵黄",
        "amount": "1個（18g）"
      },
      {
        "name": "薄力粉",
        "amount": "150g"
      },
      {
        "name": "アーモンドパウダー",
        "amount": "30g"
      },
      {
        "name": "チョコチップ",
        "amount": "30g"
      },
      {
        "name": "紅茶",
        "amount": "ティーバッグ2個分（4g）"
      },
      {
        "name": "グラニュー糖",
        "amount": "適量"
      }
    ],
    "steps": [
      "室温に戻したバターをクリーム状に練り、粉糖を加えすり混ぜる",
      "卵黄を加えよく混ぜる",
      "ふるった薄力粉とアーモンドパウダーを加え、ゴムベラで切るように混ぜる。ポロポロになったら生地をボウルにすりつけてまとめる",
      "生地の半量をラップにとり、チョコチップを混ぜ込む（縦横にたたむと手が汚れにくい）",
      "残り半量の生地には紅茶葉を混ぜ込む",
      "それぞれをラップに包んで棒状に成形する",
      "冷蔵庫で3時間以上しっかり冷やす",
      "オーブンを予熱しておく",
      "生地にグラニュー糖をまぶし、約1.5cm幅にカットする",
      "シルパンを敷いた天板に並べ、170℃のオーブンで18分焼成（生地が広がるので間隔をあける）",
      "焼き上がったらすぐにケーキクーラーに乗せ、完全に冷めたら完成"
    ],
    "tags": [
      "デザート・菓子"
    ],
    "sourceType": "notion",
    "sourceUrl": "",
    "memo": "チョコチップや紅茶以外、ナッツ類やココアパウダーを入れても美味しい"
  },
  {
    "title": "パンケーキ",
    "servings": "",
    "ingredients": [
      {
        "name": "卵黄",
        "amount": "4個"
      },
      {
        "name": "牛乳",
        "amount": "30ml"
      },
      {
        "name": "バニラエッセンス",
        "amount": "4滴"
      },
      {
        "name": "サラダ油",
        "amount": "20ml"
      },
      {
        "name": "ベーキングパウダー",
        "amount": "小さじ1/2"
      },
      {
        "name": "薄力粉",
        "amount": "60g"
      },
      {
        "name": "卵白",
        "amount": "6個"
      },
      {
        "name": "グラニュー糖",
        "amount": "60g"
      },
      {
        "name": "コーンスターチ",
        "amount": "大さじ4弱"
      },
      {
        "name": "レモン汁",
        "amount": "小さじ1"
      }
    ],
    "steps": [
      "卵黄材料を全て混ぜる（粉ものはふるって加える）",
      "よく冷やした卵白を角が立ちつやが出るまで泡立てる（グラニュー糖は3回に分けて投入）",
      "角止めにレモン汁を入れ、コーンスターチを加えさらに泡立てる（高速だと粗いスポンジになるので中速が良い）",
      "卵黄の生地に泡立てた卵白を少し入れよく混ぜ合わせる",
      "残りの卵白を全て入れ、泡をつぶさないようさっくり混ぜる（ボールを移し替えると混ざりやすい）",
      "シリコン型にサラダ油を塗る",
      "型の八分目まで生地を入れる",
      "ホットプレート（2台）を保温弱に設定し、型を置いて蓋をして15分",
      "返して10分〜電源を切って蒸らし5分〜蓋をずらして3分〜蓋を取って2分",
      "型から外し、キッチンペーパーを敷いた金網の上で冷ます"
    ],
    "tags": [
      "デザート・菓子"
    ],
    "sourceType": "notion",
    "sourceUrl": "",
    "memo": "冷凍可。解凍は凍ったままラップなしで2個600Wで1分"
  },
